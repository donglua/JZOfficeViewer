{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "abiFilters": [
        "arm64-v8a",
        "x86_64"
      ]
    },
    "nativeLib": {
      "filter": {
        "excludes": [
          "**/armeabi-v7a/**"
        ]
      }
    }
  },
  "targets": [
    {
      "name": "default"
    }
  ]
}
